# Supabase — public project data (read-only)
# Copy this file to `.env.local` and fill in the values from your Supabase project
# Dashboard: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Resend — contact form email delivery (optional)
# Create a key at https://resend.com/api-keys
# Without this, the contact form falls back to opening the visitor's email app.
RESEND_API_KEY=re_your_api_key
# Optional custom sender (must be a domain verified in Resend).
# Defaults to Resend's onboarding sender when unset.
# CONTACT_FROM_EMAIL=AldMind <noreply@yourdomain.com>

# Gemini — server-side portfolio chatbot (never use a NEXT_PUBLIC_ prefix)
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
